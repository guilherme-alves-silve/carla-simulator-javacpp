<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.guilherme-alves-silve</groupId>
    <artifactId>carla-simulator-javacpp</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>CARLA JavaCPP Integration</name>
    <description>JavaCPP preset and Python-like Java facade for CARLA.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javacpp.version>1.5.10</javacpp.version>
        <junit.version>5.10.2</junit.version>
        <failsafe.version>3.2.5</failsafe.version>
        <build-helper.version>3.5.0</build-helper.version>
        <maven.javadoc.version>3.7.0</maven.javadoc.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <maven.source.version>3.3.1</maven.source.version>
        <carla.include.dir>${env.CARLA_INCLUDE_DIR}</carla.include.dir>
        <carla.lib.dir>${env.CARLA_LIB_DIR}</carla.lib.dir>
        <carla.native.include.dir>${project.basedir}/src/main/cpp</carla.native.include.dir>
        <!--
          Native platform classifier; defaults to the OS detected by
          the os-maven-plugin extension. Matches the `value`
          attributes of the @Platform annotations on CarlaNative
          (windows-x86_64, linux-x86_64). Override on the command
          line with -Dcarla.native.platform=... for cross builds.
        -->
        <carla.native.platform>${os.detected.classifier}</carla.native.platform>
        <javacpp.compiler.skip>false</javacpp.compiler.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <!--
              Detects the host OS/arch at build time and exposes it
              as ${os.detected.classifier} (e.g. windows-x86_64,
              linux-x86_64). Required so the JavaCPP @Platform
              selection and the maven-jar-plugin classifier stay in
              sync with the actual build host. Standard pattern used
              by all official JavaCPP presets.
            -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.version}</version>
                <configuration>
                    <source>17</source>
                    <release>17</release>
                    <doclint>all,-missing,-syntax,-html,-reference</doclint>
                    <failOnError>false</failOnError>
                    <failOnWarnings>false</failOnWarnings>
                    <quiet>true</quiet>
                    <sourcepath>${project.basedir}/src/main/java</sourcepath>
                    <excludePackageNames>
                        org.carla.javacpp.binding,
                        org.carla.javacpp.examples
                    </excludePackageNames>
                </configuration>
                <executions>
                    <!--
                      Build the browsable Javadoc HTML on `mvn package`
                      and inside the project site, so the documentation
                      is always in sync with the source. Output:
                        target/site/apidocs/index.html
                    -->
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                    <!--
                      Produce the browsable -javadoc.jar alongside the
                      main artifact on `mvn package`:
                        target/<artifactId>-<version>-javadoc.jar
                    -->
                    <execution>
                        <id>attach-javadoc-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Produces the -sources.jar alongside the main artifact on
              `mvn package`:
                target/<artifactId>-<version>-sources.jar

              Excludes the same packages as the Javadoc config so the
              generated JAR only contains the public API surface, not
              the JavaCPP-generated binding or the bundled examples.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.version}</version>
                <configuration>
                    <excludes>
                        <exclude>org/carla/javacpp/binding/**</exclude>
                        <exclude>org/carla/javacpp/examples/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.bytedeco</groupId>
                        <artifactId>javacpp</artifactId>
                        <version>${javacpp.version}</version>
                        <configuration>
                            <classPath>${project.build.outputDirectory}</classPath>
                            <includePaths>
                                <includePath>${carla.native.include.dir}</includePath>
                                <includePath>${carla.include.dir}</includePath>
                            </includePaths>
                            <linkPaths>
                                <linkPath>${carla.lib.dir}</linkPath>
                            </linkPaths>
                        </configuration>
                        <executions>
                            <execution>
                                <id>javacpp-compiler</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <configuration>
                                    <skip>${javacpp.compiler.skip}</skip>
                                    <classOrPackageName>org.carla.javacpp.binding.CarlaNative</classOrPackageName>
                                    <copyLibs>true</copyLibs>
                                    <copyResources>true</copyResources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <execution>
                                <id>default-jar</id>
                                <configuration>
                                    <excludes>
                                        <exclude>org/carla/javacpp/binding/${carla.native.platform}/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>platform-native-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>${carla.native.platform}</classifier>
                                    <includes>
                                        <include>org/carla/javacpp/binding/${carla.native.platform}/jniCarlaNative.dll</include>
                                        <include>org/carla/javacpp/binding/${carla.native.platform}/libjniCarlaNative.so</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper.version}</version>
                        <executions>
                            <execution>
                                <id>add-integration-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/integration-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${failsafe.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
